# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:8080
DATABASE_URL=postgres://pronatec:change-me@localhost:5432/pronatec

# Random secret, at least 32 characters. Keep it stable across releases: it protects
# upload sessions and participant identity keys.
SECURITY_KEY=replace-with-at-least-32-random-characters
# Generate with: echo "your passphrase" | node backend/scripts/password-hash.js
ADMIN_PASSWORD_HASH=generate-with-backend/scripts/password-hash.js
# Optional shared access code (6+ characters) for the SETEC and Coordenação dashboards.
DASHBOARD_ACCESS_KEY=

# Private S3-compatible storage
S3_ENDPOINT=http://localhost:9000
# Optional browser-reachable endpoint when the backend uses an internal hostname.
S3_SIGNING_ENDPOINT=
S3_BUCKET=pronatec-private
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Set to true for S3 gateways without native multipart listing (e.g. rclone over Drive).
S3_DURABLE_PARTS=false
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Cloudflare Turnstile (required in production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Test-only; rejected when NODE_ENV=production.
CAPTCHA_TEST_BYPASS=false

# ClamAV daemon
CLAMD_HOST=localhost
CLAMD_PORT=3310

# Limits
UPLOADS_PER_HOUR=10
STORAGE_QUOTA_BYTES=21474836480
DAILY_UPLOAD_QUOTA_BYTES=10737418240

# Reverse proxy
TRUST_PROXY_CIDRS=
# Fly.io only: trust the Fly-Client-IP header (also requires FLY_APP_NAME).
TRUST_FLY_PROXY=false

# Scheduled Google Sheets -> PostgreSQL sync (read-only Drive scope).
# Leave the GOOGLE_* values empty to disable it and use the admin CSV import instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
LEGACY_RESPONSES_SHEET_ID=
LEGACY_OFFERS_SHEET_ID=
SYNC_INTERVAL_MINUTES=10
